# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database + raw capture audit trail
data/

# agent harness state
.mimosa/
.workbuddy-ai/

# unrelated project that was dropped into this workspace
