# Provider selection — swap market data source with one env var
PRICE_PROVIDER=yahoo          # yahoo | finnhub | alphavantage

# Keys for providers that need them. NOTE: as of the launch decision
# (docs/LICENSING.md) neither finnhub nor alphavantage is confirmed
# display-permitted — they are "unlicensed" until their redistribution terms
# are read and recorded. Yahoo needs no key.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# UK Companies House (Chunk 10: beneficial-owner enrichment of overseas entities)
COMPANIES_HOUSE_KEY=

# HM Land Registry — OCOD (Overseas Companies Ownership Data).
# OCOD is NOT anonymously downloadable: a free HMLR account is required to pull
# the monthly file via the API. If unset, the loader reads a local capture from
# data/raw/uk/ocod/ instead (see src/lib/providers/uk/ocod.ts).
HMLR_API_KEY=

# SEC EDGAR — polite User-Agent required by SEC
SEC_USER_AGENT=RichTracker/1.0 (taylorc697@gmail.com)

# Free-API integrations (Chunk 12). Keys are free signups; keep them here,
# never in code. Keyless providers need nothing.
# Postcodes.io (UK postcode → globe coordinates): no key.
# OpenFIGI (ticker → FIGI mapping): free key raises limits to 25 req/6s +
# 100 jobs/request (keyless: 25 req/min, 5 jobs/request).
OPENFIGI_API_KEY=
# GNews (news → events, 100 req/day free). Runs cost 1 + --people requests;
# raise the budget only if the plan allows it.
GNEWS_API_KEY=
GNEWS_DAILY_LIMIT=100
# FRED (macro series, 120 req/min published ceiling; loader uses 3 calls/run).
# History window for macro_observations (default: 5 years ago).
FRED_API_KEY=
FRED_SINCE=

# Optional overrides
FX_PROVIDER=frankfurter
