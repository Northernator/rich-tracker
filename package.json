{
  "name": "rich_tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "rebuild": "node --import tsx/cjs src/lib/db/rebuild.ts",
    "prices": "pnpm exec tsx src/lib/db/load_slice_prices.ts",
    "ciks:resolve": "pnpm exec tsx src/lib/db/resolve_ciks.ts",
    "holdings:sec": "pnpm exec tsx src/lib/db/load_sec_holdings.ts",
    "pledges:sec": "pnpm exec tsx src/lib/db/load_pledges.ts",
    "verify:pledges": "pnpm exec tsx scripts/verify_pledges.ts",
    "aircraft:faa": "pnpm exec tsx src/lib/db/load_aircraft.ts",
    "verify:aircraft": "pnpm exec tsx scripts/verify_aircraft.ts",
    "property:uk": "pnpm exec tsx src/lib/db/load_uk_property.ts",
    "verify:chains": "pnpm exec tsx scripts/verify_chains.ts",
    "offshore:icij": "pnpm exec tsx src/lib/db/load_icij_offshore.ts",
    "verify:offshore": "pnpm exec tsx scripts/verify_offshore.ts",
    "snapshot": "pnpm exec tsx src/lib/db/snapshot.ts",
    "cron": "pnpm exec tsx src/lib/cron/worker.ts",
    "fix:data": "node scripts/fix_data.mjs",
    "db:backup": "node -e \"const D=require('better-sqlite3');const d=new D('data/app.db');d.backup('data/backups/manual-'+Date.now()+'.db').then(()=>console.log('ok'))\"",
    "fix:data2": "node scripts/fix_data_v2.mjs"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "globe.gl": "^2.46.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "node-cron": "^4.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
